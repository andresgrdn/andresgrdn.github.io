---
import { Image } from 'astro:assets';

interface Props {
    title: string;
    description: string;
    tags: string[];
    image: ImageMetadata;
    repoUrl: string;
    liveUrl?: string;
}

const { title, description, tags, image, repoUrl, liveUrl } = Astro.props;
---

<article class="card">
    <div class="image-showcase">
        <Image
            src={image}
            alt={`${title} project screenshot`}
            widths={[320, 480, 640, 900]}
            sizes="(max-width: 767px) calc(100vw - 80px), (max-width: 1400px) calc((100vw - 180px) / 2), 610px"
            loading="lazy"
            decoding="async"
        />
    </div>

    <div class="card__description">
        <p>
            {description}
        </p>

        <ul>
            {tags.map((tag) => <li>#{tag}</li>)}
        </ul>

        <div class="card__buttons">
            <a href={repoUrl} target="_blank" rel="noopener noreferrer">Code</a>
            {
                liveUrl && (
                    <a href={liveUrl} target="_blank" rel="noopener noreferrer">
                        Live site
                    </a>
                )
            }
        </div>
    </div>
</article>

<style>
    .card {
        .image-showcase {
            border: 1px solid var(--black-accent);
        }

        img {
            display: block;
            width: 100%;
            height: 66%;
            max-height: 250px;

            object-fit: contain;
            object-position: center;
        }

        .card__description {
            padding: 1.4rem;

            font-family: "Inter", sans-serif;

            p {
                margin-bottom: 8px;

                font-weight: 400;
                font-size: 1.2rem;
                line-height: 1.8rem;

                color: var(--grey-dark);
            }

            ul {
                margin-bottom: 14px;

                list-style: none;
            }

            li {
                display: inline-block;

                padding: 2px 4px;

                font-weight: 400;
                font-size: 1rem;
                line-height: 1.2rem;

                background: var(--grey-light);
                color: var(--black-accent);
            }

            ul>li+li {
                margin-left: 12px;
            }
        }
    }

    .card__buttons {
        a {
            display: inline-flex;
            justify-content: center;
            align-items: center;

            border: 2px solid var(--black-accent);
            border-radius: 2px;
            min-width: 86px;
            height: 27px;

            font-family: "DM Sans", sans-serif;
            text-decoration: none;
            font-weight: var(--dm-sans-bold);
            font-size: 1.4rem;
            line-height: 1.8rem;

            color: var(--black-accent);
        }

        a:hover {
            box-shadow: var(--outer-shadow-1);
        }

        a:active {
            box-shadow: var(--inner-shadow);
            border-width: 1px;
            font-weight: var(--dm-sans-regular);
        }

        >a+a {
            margin-left: 24px;
        }
    }
</style>
