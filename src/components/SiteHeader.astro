---
import SocialLinks from './SocialLinks.astro';
---

<header class="header-container">
    <div class="page-title">
        <img class="profile-image" src="/icons/logo-personal-v1.svg" alt="Andres Gordon Logo">
        <h1>
            Andy Gordon
        </h1>
    </div>

    <SocialLinks />
</header>

<style>
    .header-container {
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
        background-color: var(--white);

        .page-title {
            display: flex;
            gap: 1rem;
            align-items: center;
            justify-content: center;

            h1 {
                font-size: 2.4rem;
                text-align: center;

                color: var(--black-accent);
            }

            .profile-image {
                display: block;

                width: 100%;
                max-width: 24px;

                object-fit: cover;
                object-position: center;
                overflow: hidden;
            }
        }
    }
</style>
